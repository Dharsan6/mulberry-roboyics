<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_simulator</name>
  <version>1.0.0</version>
  <description>ROS 2 telemetry publisher and 4-state sequential rover simulator node</description>
  <maintainer email="agronomy@precision-sericulture.org">Precision Sericulture Team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rover_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
